{
  "name": "spsc-testbed",
  "version": "0.0.1",
  "description": "spsc testbed",
  "author": "qbane",
  "type": "module",
  "private": true,
  "workspaces": [
    ".",
    "packages/spsc"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || true",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.app.json",
    "tsc": "tsc -b jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "~5.5.4",
    "@sveltejs/kit": "~2.60.1",
    "@sveltejs/vite-plugin-svelte": "~5.1.1",
    "@types/node": "~22.19.19",
    "svelte": "~5.55.9",
    "svelte-check": "~4.4.8",
    "typescript": "~5.9.3",
    "vite": "~6.4.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "~4.1.7"
  },
  "engines": {
    "node": ">=20.0.0 <25.0.0"
  },
  "dependencies": {
    "spsc": "*"
  }
}
